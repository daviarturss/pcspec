<Window x:Class="PcSpec.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PcSpec — especificações do PC"
        Height="880" Width="1200"
        MinHeight="620" MinWidth="980"
        Background="{StaticResource WindowBackground}"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- Linha rotulo/valor das abas. -->
        <DataTemplate x:Key="RowTemplate">
            <Grid Margin="0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Label}" FontSize="12" TextTrimming="CharacterEllipsis"
                           Foreground="{StaticResource TextSecondary}" />
                <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="12.5" TextWrapping="Wrap" />
            </Grid>
        </DataTemplate>

        <!-- Cartao de um módulo de memória ou de uma placa de vídeo. -->
        <DataTemplate x:Key="GroupTemplate">
            <Border Background="{StaticResource RowBackground}" BorderBrush="{StaticResource Border}"
                    BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource RowTemplate}" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- Linha da tabela de benchmark. -->
        <DataTemplate x:Key="BenchRowTemplate">
            <Grid Margin="0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Name}" FontSize="12.5" />
                <TextBlock Grid.Column="1" Text="{Binding SingleText}" FontSize="12.5"
                           Foreground="{StaticResource TextSecondary}" />
                <TextBlock Grid.Column="2" Text="{Binding MultiText}" FontSize="12.5" />
                <TextBlock Grid.Column="3" Text="{Binding SingleScoreText}" FontSize="12.5"
                           TextAlignment="Right" Margin="0,0,18,0" Foreground="{StaticResource TextSecondary}" />
                <TextBlock Grid.Column="4" Text="{Binding MultiScoreText}" FontSize="12.5"
                           TextAlignment="Right" Margin="0,0,18,0" />
                <ProgressBar Grid.Column="5" Value="{Binding BarPercent}" Maximum="100"
                             Width="150" HorizontalAlignment="Left" VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>

        <!-- Texto de observação (uma por linha, discreto). -->
        <DataTemplate x:Key="NoteTemplate">
            <TextBlock Text="{Binding}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,6"
                       Foreground="{StaticResource TextSecondary}" />
        </DataTemplate>

        <!-- Placar do benchmark: verde quando medido, cinza enquanto não ha dados. -->
        <Style x:Key="ScoreValue" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="26" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource Good}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasBenchmark}" Value="False">
                    <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ScalingValue" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="26" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource Accent}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasBenchmark}" Value="False">
                    <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Cabecalho -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="PcSpec" FontSize="22" FontWeight="SemiBold" />
                    <TextBlock Text="0.1" FontSize="12" Margin="8,7,0,0" Foreground="{StaticResource Accent}" />
                </StackPanel>
                <TextBlock Text="{Binding MachineName}" FontSize="13" Margin="0,2,0,0"
                           Foreground="{StaticResource TextSecondary}" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Atualizar" Command="{Binding RefreshCommand}" />
                <Button Content="Benchmark" Command="{Binding BenchmarkCommand}" />
                <Button Content="Salvar TXT" Command="{Binding SaveTextCommand}" />
                <Button Content="Salvar HTML" Command="{Binding SaveHtmlCommand}" />
                <Button Content="Copiar" Command="{Binding CopyReportCommand}" Margin="0" />
            </StackPanel>
        </Grid>

        <!-- Chips de resumo -->
        <WrapPanel Grid.Row="1" Margin="0,0,0,12">
            <Border Style="{StaticResource Card}" Padding="12,8" Margin="0,0,8,8" MinWidth="150" MaxWidth="300">
                <StackPanel>
                    <TextBlock Text="CPU" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" />
                    <TextBlock Text="{Binding CpuSummary}" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Padding="12,8" Margin="0,0,8,8" MinWidth="120">
                <StackPanel>
                    <TextBlock Text="MEMÓRIA" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" />
                    <TextBlock Text="{Binding MemorySummary}" FontSize="12.5" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Padding="12,8" Margin="0,0,8,8" MinWidth="150" MaxWidth="300">
                <StackPanel>
                    <TextBlock Text="PLACA-MÃE" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" />
                    <TextBlock Text="{Binding BoardSummary}" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Padding="12,8" Margin="0,0,8,8" MinWidth="150" MaxWidth="300">
                <StackPanel>
                    <TextBlock Text="GRÁFICOS" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" />
                    <TextBlock Text="{Binding GpuSummary}" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Padding="12,8" Margin="0,0,8,8" MinWidth="180" MaxWidth="360">
                <StackPanel>
                    <TextBlock Text="SISTEMA" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" />
                    <TextBlock Text="{Binding OsSummary}" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>
        </WrapPanel>

        <!-- Abas -->
        <TabControl Grid.Row="3">

            <TabItem Header="Sistema">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource Card}" Grid.Column="0" Margin="0,0,9,0" VerticalAlignment="Top">
                            <StackPanel>
                                <TextBlock Text="SISTEMA" Style="{StaticResource Caption}" />
                                <ItemsControl ItemsSource="{Binding SystemRows}" ItemTemplate="{StaticResource RowTemplate}" />
                            </StackPanel>
                        </Border>

                        <StackPanel Grid.Column="1" Margin="9,0,0,0">
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="BIOS" Style="{StaticResource Caption}" />
                                    <ItemsControl ItemsSource="{Binding BiosRows}" ItemTemplate="{StaticResource RowTemplate}" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,12,0,0"
                                    Visibility="{Binding HasDiagnostics, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <TextBlock Text="DIAGNÓSTICO" Style="{StaticResource Caption}" />
                                    <ItemsControl ItemsSource="{Binding Diagnostics}" ItemTemplate="{StaticResource NoteTemplate}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="CPU">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,9,0">
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="PROCESSADOR" Style="{StaticResource Caption}" />
                                    <ItemsControl ItemsSource="{Binding CpuRows}" ItemTemplate="{StaticResource RowTemplate}" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                                <StackPanel>
                                    <TextBlock Text="INSTRUÇÕES" Style="{StaticResource Caption}" />
                                    <TextBlock Text="{Binding Instructions}" Style="{StaticResource Mono}" LineHeight="19" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="9,0,0,0">
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="CACHES" Style="{StaticResource Caption}" />
                                    <ItemsControl ItemsSource="{Binding CacheRows}" ItemTemplate="{StaticResource RowTemplate}" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,12,0,0"
                                    Visibility="{Binding HasCpuNotes, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <TextBlock Text="OBSERVAÇÕES" Style="{StaticResource Caption}" />
                                    <ItemsControl ItemsSource="{Binding CpuNotes}" ItemTemplate="{StaticResource NoteTemplate}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Placa-mãe">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource Card}" Grid.Column="0" Margin="0,0,9,0" VerticalAlignment="Top">
                            <StackPanel>
                                <TextBlock Text="PLACA-MÃE" Style="{StaticResource Caption}" />
                                <ItemsControl ItemsSource="{Binding BoardRows}" ItemTemplate="{StaticResource RowTemplate}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Top">
                            <StackPanel>
                                <TextBlock Text="PONTES PCI" Style="{StaticResource Caption}" />
                                <ItemsControl ItemsSource="{Binding BridgeRows}" ItemTemplate="{StaticResource RowTemplate}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Memória">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource Card}" Grid.Column="0" Margin="0,0,9,0" VerticalAlignment="Top">
                            <StackPanel>
                                <TextBlock Text="MEMÓRIA" Style="{StaticResource Caption}" />
                                <ItemsControl ItemsSource="{Binding MemoryRows}" ItemTemplate="{StaticResource RowTemplate}" />
                                <TextBlock Style="{StaticResource Mono}" Margin="0,12,0,0" Foreground="{StaticResource TextSecondary}"
                                           Text="Timings (CL/tRCD/tRP/tRAS) e perfis XMP/EXPO exigem leitura SPD por SMBus, que precisa de driver de kernel." />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Top">
                            <StackPanel>
                                <TextBlock Text="MÓDULOS" Style="{StaticResource Caption}" />
                                <ItemsControl ItemsSource="{Binding MemoryModules}" ItemTemplate="{StaticResource GroupTemplate}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Gráficos">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="ADAPTADORES DE VÍDEO" Style="{StaticResource Caption}" />
                            <ItemsControl ItemsSource="{Binding GpuGroups}" ItemTemplate="{StaticResource GroupTemplate}" />
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Benchmark">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,14,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Style="{StaticResource Card}" Grid.Column="0" Margin="0,0,6,0">
                                <StackPanel>
                                    <TextBlock Text="SINGLE-THREAD" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                                    <TextBlock Text="{Binding SingleScoreText}" Style="{StaticResource ScoreValue}" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Grid.Column="1" Margin="6,0">
                                <StackPanel>
                                    <TextBlock Text="MULTI-THREAD" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                                    <TextBlock Text="{Binding MultiScoreText}" Style="{StaticResource ScoreValue}" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Grid.Column="2" Margin="6,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="ESCALABILIDADE" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                                    <TextBlock Text="{Binding ScalingText}" Style="{StaticResource ScalingValue}" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="SUBTESTE" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" />
                                    <TextBlock Grid.Column="1" Text="1 THREAD" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" />
                                    <TextBlock Grid.Column="2" Text="N THREADS" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" />
                                    <TextBlock Grid.Column="3" Text="SCORE 1T" FontSize="10" FontWeight="SemiBold"
                                               TextAlignment="Right" Margin="0,0,18,0" Foreground="{StaticResource TextSecondary}" />
                                    <TextBlock Grid.Column="4" Text="SCORE NT" FontSize="10" FontWeight="SemiBold"
                                               TextAlignment="Right" Margin="0,0,18,0" Foreground="{StaticResource TextSecondary}" />
                                </Grid>

                                <Border Height="1" Background="{StaticResource Border}" Margin="0,0,0,4" />

                                <ItemsControl ItemsSource="{Binding BenchRows}" ItemTemplate="{StaticResource BenchRowTemplate}" />

                                <TextBlock Text="{Binding BenchSummary}" FontSize="11.5" TextWrapping="Wrap"
                                           Margin="0,12,0,0" Foreground="{StaticResource TextSecondary}" />

                                <ItemsControl ItemsSource="{Binding BenchNotes}" ItemTemplate="{StaticResource NoteTemplate}"
                                              Margin="0,8,0,0" />

                                <Button Content="Executar benchmark" Command="{Binding BenchmarkCommand}"
                                        HorizontalAlignment="Left" Margin="0,14,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Relatório">
                <Grid Margin="0,14,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="Salvar TXT" Command="{Binding SaveTextCommand}" />
                        <Button Content="Salvar HTML" Command="{Binding SaveHtmlCommand}" />
                        <Button Content="Copiar" Command="{Binding CopyReportCommand}" Margin="0" />
                    </StackPanel>

                    <Border Grid.Row="1" Background="#0F1319" BorderBrush="{StaticResource Border}"
                            BorderThickness="1" CornerRadius="6" Padding="12">
                        <TextBox Text="{Binding ReportText, Mode=OneWay}"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 TextWrapping="NoWrap"
                                 FontFamily="Cascadia Mono, Consolas"
                                 FontSize="12"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto" />
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Barra de status -->
        <Grid Grid.Row="4" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Status}" FontSize="12" Foreground="{StaticResource TextSecondary}" />
                <TextBlock Text="{Binding BusyText}" FontSize="12" Margin="10,0,0,0" Foreground="{StaticResource Accent}" />
            </StackPanel>

            <TextBlock Grid.Column="1" FontSize="11" Foreground="{StaticResource TextSecondary}"
                       Text="CPUID · SMBIOS · WMI · registro do Windows" />
        </Grid>
    </Grid>
</Window>
